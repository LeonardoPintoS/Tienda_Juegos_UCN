# =============================================
# GameVault UCN - Variables de entorno
# Copia este archivo como .env:  cp .env.example .env
# NUNCA subas el .env real a GitHub.
# =============================================

# --- Aplicación ---
APP_NAME="GameVault UCN"
# development | production
# production exige credenciales reales de Resend, Cloudinary y un SECRET_KEY propio
ENVIRONMENT=development
# true = muestra en consola las consultas SQL
DEBUG=true
# Orígenes permitidos por CORS: * o una lista separada por comas
CORS_ORIGINS=*

# --- Base de datos ---
DATABASE_URL=sqlite:///./gamevault.db

# --- Seguridad / JWT ---
# Genera una clave propia con:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-secret-key-in-your-own-env-file
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate limiting (endpoints de /auth) ---
RATE_LIMIT_AUTH=5/minute

# --- Verificación de correo (registro) ---
VERIFICATION_CODE_LENGTH=6
VERIFICATION_CODE_TTL_MINUTES=15
VERIFICATION_MAX_ATTEMPTS=5
VERIFICATION_BLOCK_MINUTES=30
VERIFICATION_RESEND_COOLDOWN_SECONDS=60

# --- Jobs programados (APScheduler) ---
SCHEDULER_ENABLED=true
UNVERIFIED_ACCOUNT_TTL_HOURS=48
BLACKLIST_PURGE_INTERVAL_HOURS=6
GUEST_CART_TTL_DAYS=30

# --- Seeder (datos de prueba) ---
SEED_ON_STARTUP=true
ADMIN_EMAIL=admin@gamevault.ucn.cl
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME="Administrador GameVault"

# --- Resend (correos) ---
# Vacío = modo dev-outbox (los correos se guardan en disco, no se envían)
RESEND_API_KEY=
RESEND_FROM_EMAIL="GameVault UCN <no-reply@gamevault.ucn.cl>"

# --- Cloudinary (imágenes del catálogo) ---
# Vacío = modo dev-local (las imágenes se guardan en disco)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=